# ---- Project ----
# Raw page snapshots: large, regenerable, and not the deliverable.
# corpus/manifest.jsonl is the accounting record and IS tracked.
corpus/raw/
# crawl resume state, local to a machine
corpus/.crawl_pass.json
corpus/extracted/
corpus/chunks.jsonl
corpus/baseline_chunks.jsonl
corpus/chunks_no_boilerplate.jsonl
corpus/baseline_chunks_no_boilerplate.jsonl
*.warc
*.warc.gz

# Vector and keyword indexes are build artifacts of corpus + config.
indexes/
*.lance/
lancedb/

# Model weights, never in git.
models/
*.gguf
*.onnx
*.safetensors

# Run outputs. The generated RESULTS.md is tracked; the raw run dirs are not.
# `runs/*` (not `runs/`) is deliberate: once a directory itself is excluded,
# git will not re-include anything below it no matter what a later `!`
# pattern says -- the previous `runs/` + `!runs/.gitkeep` pair looked right
# but silently never worked (verified with `git check-ignore -v`). Ignoring
# each *entry inside* runs/ individually is what lets a later `!` un-ignore
# one specific run directory.
runs/*
!runs/.gitkeep
# Control-condition baselines ARE committed (Task 15/20/etc.'s own acceptance
# criterion): the reference point every ablation is measured against has to
# be reproducible from the repo itself, not just from a RESULTS.md number.
# Exploratory ablation run dirs (Phase 4) stay regenerable/untracked.
!runs/20260914T203423Z_318f7310fe60/

# Locks and decisions ARE tracked — they are the provenance record.
# Listed here only to document that their exclusion would be a mistake:
# !**/corpus.lock, !**/model.lock, !**/split.lock, !decisions/

# Claude Code local session state
.claude/

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
